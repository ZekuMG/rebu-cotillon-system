VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: run the app without reading/writing Supabase.
VITE_REBU_LOCAL_DEMO=false

# Required for atomic cloud sales, orders, points and stock operations.
# This enables the RPCs; it does not open a Supabase Auth/JWT session.
VITE_REBU_ENABLE_TRANSACTION_RPC=1

# Required only when publishing an Electron release to GitHub.
# Create a GitHub personal access token with access to the release repository.
# Never commit a real token here.
GH_TOKEN=

# Optional debug/legacy flags.
VITE_SHOW_ASSOCIATED_EXCEL_ROWS=false
VITE_SHOW_LEGACY_ORDER_DEPOSIT=false

# Optional: only needed on desktop builds that use AI image editing.
# Never commit a real key here.
OPENAI_API_KEY=

# API privada del bot de WhatsApp. Las PCs remotas deben pertenecer al tailnet.
# La central usa automáticamente http://127.0.0.1:3000 mediante su identidad local.
REBU_WHATSAPP_BOT_URL=https://rebu-whatsapp-central.tailbdf1e7.ts.net
# Keep these at 0 for the temporary no-JWT release.
VITE_REBU_PERSIST_AUTH_SESSION=0
# Abre sesion de Supabase Auth al entrar, en vez de trabajar como anonimo.
# Probado el 13-sep-2026 contra produccion: con esto prendido, 11 de 14 consultas
# de la caja viajan como "authenticated" y solo quedan como anonimas las tres de la
# puerta de entrada (listar operadores, validar la contraseña y pedir el token).
# Es lo que habilita cerrar los permisos de anon sobre las tablas del punto de venta.
# Si el inicio de sesion falla, la aplicacion sigue funcionando como antes: no bloquea.
# OJO: el .env real no se versiona. Quien arme el instalador en otra maquina tiene
# que prender esta bandera ahi tambien, o la version publicada saldra sin sesion.
VITE_REBU_WHATSAPP_AUTH_SESSION=1
