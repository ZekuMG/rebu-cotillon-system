{
  "name": "cotillon-rebu-system",
  "productName": "Rebu Cotillón",
  "version": "1.1.18",
  "private": true,
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test:regression": "node --test tests/data-integrity.test.js tests/cloud-load-control.test.js tests/realtime-sync.test.js tests/transaction-sync.test.js tests/order-deposit.test.js",
    "test:smoke:offline": "playwright test scripts/smoke-offline.spec.cjs scripts/dashboard-dark-loading.spec.cjs --reporter=line --workers=1",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -s first \"cross-env BROWSER=none npm run dev -- --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .\"",
    "electron:build": "vite build && electron-builder -w --publish always",
    "publish": "dotenv electron-builder -- --publish always",
    "dev:fresh": "npm run build && npm run electron:dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.3",
    "sweetalert2": "^11.14.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-legacy": "5.3.2",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^11.0.0",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "globals": "^15.11.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "terser": "5.46.0",
    "vite": "^5.4.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.rebu.app",
    "productName": "Rebu Cotillón System",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "public/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "ZekuMG",
      "repo": "rebu-cotillon-system"
    }
  }
}
